// Allow anyone to read deals (public landing page will need it),
// but only service accounts can write.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /deals/{dealId} {
      allow read: if true;                       // public
      allow write: if request.auth.uid == null   // disallow signed-in users
                  && request.auth.token.email.endsWith('@gserviceaccount.com'); 
    }
  }
}
